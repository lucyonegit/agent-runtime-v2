{
  "name": "agent-runtime-v2",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "copy:runtime-config": "node --input-type=module -e \"import { copyFileSync, mkdirSync } from 'node:fs'; mkdirSync('dist/src/config', { recursive: true }); copyFileSync('src/config/runtime.json', 'dist/src/config/runtime.json');\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run copy:runtime-config",
    "serve": "node dist/src/server/main.js",
    "dev:server": "node --enable-source-maps --loader ts-node/esm src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'dist/**' --exclude '.agent-sandbox/**' --exclude 'tests/postgres*.test.ts'",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:all": "npm test && npm run test:postgres",
    "schema:reset": "npm run build && node dist/scripts/reset-agent-runtime-schema.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/openai": "^1.5.3",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "file:../agent/node_modules/@types/node",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "file:../agent/node_modules/typescript",
    "vitest": "file:../agent/node_modules/vitest"
  }
}
