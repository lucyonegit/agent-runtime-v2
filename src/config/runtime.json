{
  "runtime": {
    "workerId": "auto",
    "sandboxRoot": ".agent-sandbox"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "bodyLimitBytes": 1048576,
    "authToken": "",
    "debugEndpointsEnabled": false,
    "toolCapabilities": ["artifacts", "filesystem", "shell", "browser"],
    "logger": ["error", "warn", "log"],
    "cors": {
      "origin": ["http://127.0.0.1:5174", "http://localhost:5174"],
      "credentials": false,
      "methods": ["GET", "HEAD", "POST", "DELETE", "OPTIONS"],
      "allowedHeaders": ["authorization", "content-type"]
    }
  },
  "postgres": {
    "url": "",
    "maxConnections": 10,
    "idleTimeoutMs": 30000,
    "connectionTimeoutMs": 10000,
    "ssl": false
  },
  "model": {
    "provider": "dashscope",
    "apiKey": "",
    "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "modelName": "qwen3.7-max",
    "temperature": 0,
    "streaming": true,
    "requestTimeoutMs": 120000,
    "maxRetries": 2,
    "tokens": {
      "contextWindowTokens": null,
      "inputTokenLimit": null,
      "outputTokenLimit": 4096
    }
  },
  "execution": {
    "maxIterations": 24,
    "maxToolCalls": 48,
    "deadlineMs": 900000,
    "ownershipTimeoutMs": 30000,
    "ownershipRefreshMs": 10000,
    "startupRecoveryGraceMs": 5000,
    "recoveryBatchSize": 32
  },
  "context": {
    "keepRecentInputTokens": 24000,
    "maxToolResultTokens": 8000,
    "summaryMaxTokens": 4000
  },
  "tools": {
    "enabled": {
      "hitl": true,
      "basic": true,
      "artifacts": true,
      "filesystem": true,
      "shell": true,
      "managedProcesses": true,
      "browser": true
    },
    "filesystem": {
      "maximumWriteCharacters": 6000,
      "maximumWriteEstimatedTokens": 2000
    },
    "shell": {
      "executable": "/bin/zsh",
      "defaultTimeoutMs": 300000,
      "maximumTimeoutMs": 1800000
    },
    "managedProcesses": {
      "portRangeStart": 4100,
      "portRangeEnd": 4999,
      "defaultStartupTimeoutMs": 60000,
      "maximumStartupTimeoutMs": 300000
    },
    "browser": {
      "requestTimeoutMs": 30000,
      "maximumResponseBytes": 1048576,
      "allowProxyFakeIps": false
    },
    "environment": {
      "inheritedKeys": [
        "PATH",
        "HOME",
        "USER",
        "LOGNAME",
        "SHELL",
        "TMPDIR",
        "TMP",
        "TEMP",
        "LANG",
        "LC_ALL",
        "LC_CTYPE",
        "TERM",
        "COLORTERM"
      ]
    }
  }
}
